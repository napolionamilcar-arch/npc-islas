-- ==================== Lógica estilo tu fly script ====================
local function setCollisions(char, enable)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = enable
        end
    end
end

local function findHomeNPC(root)
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return nil end

    for _, v in pairs(npcs:GetDescendants()) do
        if v:IsA("Model") and (v.Name:find("Punto Principal") or v.Name:find("Home") or v.Name:find("Set Home")) then
            local ok, pos = pcall(function() return v:GetPivot().Position end)
            if ok and pos then
                local dist = (pos - root.Position).Magnitude
                if dist < 90 then
                    return v, pos
                end
            end
        end
    end
    return nil
end

local function safeGoTo(data)
    if isBusy then return end
    isBusy = true

    local char, root, hum = getChar()
    info.Text = "Yendo a " .. data.N

    -- Crear parte temporal (igual que tu fly)
    local flightPart = Instance.new("Part")
    flightPart.Size = Vector3.new(4, 0.5, 4)
    flightPart.Transparency = 1
    flightPart.Anchored = true
    flightPart.CanCollide = false
    flightPart.CanTouch = false
    flightPart.CanQuery = false
    flightPart.CFrame = CFrame.new(data.P + Vector3.new(0, 4, 0))
    flightPart.Parent = workspace

    -- Estado físico
    hum.PlatformStand = true
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    setCollisions(char, false)

    -- Mover al jugador a la parte
    root.CFrame = flightPart.CFrame + Vector3.new(0, 2.8, 0)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    -- Mantener al jugador "pegado" a la parte hasta detectar el NPC
    local connection
    local found = false
    local startTime = tick()

    connection = RS.Heartbeat:Connect(function()
        if not flightPart or not flightPart.Parent or not root or not root.Parent then
            connection:Disconnect()
            return
        end

        -- Mantener posición y velocidades
        root.CFrame = flightPart.CFrame + Vector3.new(0, 2.8, 0)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.new(0, 999, 0)

        -- Buscar NPC
        local npc, pos = findHomeNPC(root)
        if npc and pos then
            local line = string.format("%s → Vector3.new(%.1f, %.1f, %.1f)", npc.Name, pos.X, pos.Y, pos.Z)
            local exists = false
            for _, r in ipairs(results) do
                if r == line then exists = true break end
            end
            if not exists then
                table.insert(results, line)
                updateBox()
            end
            found = true
            info.Text = data.N .. " ✓ Encontrado"
            connection:Disconnect()
        elseif tick() - startTime > 14 then
            info.Text = data.N .. " ✗ Tiempo agotado"
            connection:Disconnect()
        end
    end)

    -- Esperar a que termine
    while connection.Connected do
        task.wait(0.1)
    end

    -- Restaurar
    hum.PlatformStand = false
    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    setCollisions(char, true)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    if flightPart then flightPart:Destroy() end

    isBusy = false
end

