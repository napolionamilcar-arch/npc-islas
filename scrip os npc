-- Buscar NPC cerca del jugador
local function findHomeNPC()
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return nil end

    for _, v in pairs(npcs:GetDescendants()) do
        if v:IsA("Model") and (v.Name:find("Punto Principal") or v.Name:find("Home") or v.Name:find("Set Home")) then
            local ok, pos = pcall(function() return v:GetPivot().Position end)
            if ok and pos then
                local dist = (pos - getChar().HumanoidRootPart.Position).Magnitude
                if dist < 80 then -- solo si está cerca
                    return v, pos
                end
            end
        end
    end
    return nil
end

-- Teleport + mantener anclado hasta detectar el NPC
local function goToIsland(data)
    local char, hrp, hum = getChar()

    -- Anclar y teletransportar
    hrp.Anchored = true
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(data.P + Vector3.new(0, 5, 0))

    info.Text = "Esperando NPC en " .. data.N .. "..."

    -- Esperar hasta que aparezca el NPC (máximo 12 segundos)
    local foundNPC, foundPos
    local start = tick()
    while tick() - start < 12 do
        foundNPC, foundPos = findHomeNPC()
        if foundNPC then break end
        task.wait(0.4)
    end

    if foundNPC and foundPos then
        local line = string.format("%s → Vector3.new(%.1f, %.1f, %.1f)", foundNPC.Name, foundPos.X, foundPos.Y, foundPos.Z)
        
        -- Evitar duplicados
        local exists = false
        for _, r in ipairs(results) do
            if r == line then exists = true break end
        end
        if not exists then
            table.insert(results, line)
            updateBox()
        end
        info.Text = data.N .. " ✓ Encontrado"
    else
        info.Text = data.N .. " ✗ No se encontró NPC"
    end

    -- Desanclar
    task.wait(0.3)
    hrp.Anchored = false
end

