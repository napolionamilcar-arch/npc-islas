-- 2. LÓGICA DE EXTRACCIÓN DE PROPIEDADES (PIVOT Y ATTRIBUTES)
local function escanearAtributosYPivot()
	-- Limpiar UI anterior
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextBox") and child ~= templateBox then
			child:Destroy()
		end
	end

	local carpetaSource = ReplicatedStorage:FindFirstChild(NOMBRE_CARPETA_REPLICATED)
	if not carpetaSource then
		warn("No se encontró la carpeta '" .. NOMBRE_CARPETA_REPLICATED .. "' en ReplicatedStorage.")
		title.Text = "  Error: Carpeta no encontrada"
		return
	end

	-- Leer cada NPC guardado
	for _, npc in ipairs(carpetaSource:GetChildren()) do
		if npc:IsA("Model") then
			local coords = nil
			local origen = ""

			-- Prioridad 1: Leer el atributo 'FloorPos' visible en tu imagen
			local floorPosAttr = npc:GetAttribute("FloorPos")
			if floorPosAttr and typeof(floorPosAttr) == "Vector3" then
				coords = floorPosAttr
				origen = "[FloorPos]"
			end

			-- Prioridad 2: Si no tiene atributo, leer la propiedad 'WorldPivot' de la imagen
			if not coords then
				local worldPivot = npc.WorldPivot
				if worldPivot and worldPivot.Position.Magnitude > 1 then
					coords = worldPivot.Position
					origen = "[WorldPivot]"
				end
			end

			-- Si se halló una posición válida, se formatea e inyecta en la UI
			if coords then
				local textoFormateado = string.format("%.2f, %.2f, %.2f", coords.X, coords.Y, coords.Z)
				
				local nuevaCaja = templateBox:Clone()
				nuevaCaja.Name = npc.Name
				-- Genera el formato listo para copiar y usar en scripts de Lua
				nuevaCaja.Text = string.format("%s %s = Vector3.new(%s)", origen, npc.Name, textoFormateado)
				nuevaCaja.Visible = true
				nuevaCaja.Parent = scrollFrame
			end
		end
	end

	-- Ajustar dinámicamente el tamaño del scrollbar
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 15)
end

-- Ejecutar el sistema al iniciar el juego
screenGui.Parent = playerGui
escanearAtributosYPivot()
