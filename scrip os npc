-- 2. LÓGICA REFORZADA DE EXTRACCIÓN (PROFUNDA)
local function escanearAtributosYPivot()
	-- Limpiar elementos anteriores para evitar duplicados
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextBox") and child ~= templateBox then
			child:Destroy()
		end
	end

	title.Text = "  Buscando carpeta..."
	
	-- Esperar a que la carpeta raíz exista de forma segura en el cliente
	local carpetaSource = ReplicatedStorage:WaitForChild(NOMBRE_CARPETA_REPLICATED, 5)
	if not carpetaSource then
		title.Text = "  Error: Carpeta '" .. NOMBRE_CARPETA_REPLICATED .. "' no encontrada"
		return
	end

	title.Text = "  Procesando múltiples modelos..."
	local contadorModelos = 0

	-- USAR GETDESCENDANTS: Busca de forma recursiva dentro de CUALQUIER subcarpeta
	for _, objeto in ipairs(carpetaSource:GetDescendants()) do
		if objeto:IsA("Model") then
			local coords = nil
			local origen = ""

			-- Filtro 1: Atributo 'FloorPos' (Basado en tu imagen)
			local floorPosAttr = objeto:GetAttribute("FloorPos")
			if floorPosAttr and typeof(floorPosAttr) == "Vector3" then
				coords = floorPosAttr
				origen = "[FloorPos]"
			end

			-- Filtro 2: Atributo alternativo común 'Position' o 'SpawnPoint'
			if not coords then
				local altAttr = objeto:GetAttribute("Position") or objeto:GetAttribute("SpawnPoint")
				if altAttr and typeof(altAttr) == "Vector3" then
					coords = altAttr
					origen = "[AttrPos]"
				end
			end

			-- Filtro 3: Propiedad física de lectura global 'WorldPivot' (Marcada en tu imagen)
			if not coords then
				local worldPivot = objeto.WorldPivot
				-- Validamos que el pivot no esté reseteado en el origen por defecto (0,0,0)
				if worldPivot and worldPivot.Position.Magnitude > 1 then
					coords = worldPivot.Position
					origen = "[WorldPivot]"
				end
			end

			-- Si logramos extraer datos válidos del modelo actual
			if coords then
				contadorModelos = contadorModelos + 1
				local textoFormateado = string.format("%.2f, %.2f, %.2f", coords.X, coords.Y, coords.Z)
				
				local nuevaCaja = templateBox:Clone()
				nuevaCaja.Name = objeto.Name
				-- Formato limpio listo para copiar e insertar directo en tus scripts
				nuevaCaja.Text = string.format("%s %s = Vector3.new(%s)", origen, objeto.Name, textoFormateado)
				nuevaCaja.Visible = true
				nuevaCaja.Parent = scrollFrame
			end
		end
	end

	-- Actualizar título con estadísticas de lo encontrado
	title.Text = string.format("  Modelos listados: %d", contadorModelos)
	
	-- Forzar reajuste de la barra de desplazamiento
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 20)
end

-- Conectar el botón manual
refreshButton.MouseButton1Click:Connect(escanearAtributosYPivot)

