local function scan()
    local n = workspace:FindFirstChild("NPCs")
    if n then
        for _, v in pairs(n:GetDescendants()) do
            if v:IsA("Model") and (v.Name:find("Punto Principal") or v.Name:find("Home")) then
                local ok, pos = pcall(function() return v:GetPivot().Position end)
                if ok and pos then
                    local l = string.format("%s → Vector3.new(%.1f, %.1f, %.1f)", v.Name, pos.X, pos.Y, pos.Z)
                    local e = false
                    for _, x in ipairs(r) do if x == l then e = true break end end
                    if not e then table.insert(r, l) end
                end
            end
        end
    end
    up()
end

local function safeTP(pos)
    local char, h, hum = getChar()
    local fp = Instance.new("Part")
    fp.Size = Vector3.new(3, 0.5, 3)
    fp.Transparency = 1
    fp.Anchored = true
    fp.CanCollide = false
    fp.CanTouch = false
    fp.CanQuery = false
    fp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    fp.Parent = workspace

    hum.PlatformStand = true
    hum:ChangeState(Enum.HumanoidStateType.Physics)

    local oc = {}
    for _, pt in ipairs(char:GetDescendants()) do
        if pt:IsA("BasePart") then
            oc[pt] = pt.CanCollide
            pt.CanCollide = false
        end
    end

    h.CFrame = fp.CFrame + Vector3.new(0, 2.5, 0)
    h.AssemblyLinearVelocity = Vector3.zero
    h.AssemblyAngularVelocity = Vector3.zero

    task.wait(0.25)

    hum.PlatformStand = false
    hum:ChangeState(Enum.HumanoidStateType.GettingUp)

    for pt, c in pairs(oc) do
        if pt and pt.Parent then pt.CanCollide = c end
    end
    fp:Destroy()
end

