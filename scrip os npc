local function updateBox()
    box.Text = #results > 0 and table.concat(results, "\n\n") or "Sin datos todavía..."
end

local function setCollisions(char, enable)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = enable
        end
    end
end

local function findHomeNPC(root)
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return nil end
    for _, v in pairs(npcs:GetDescendants()) do
        if v:IsA("Model") and (v.Name:find("Punto Principal") or v.Name:find("Home") or v.Name:find("Set Home")) then
            local ok, pos = pcall(function() return v:GetPivot().Position end)
            if ok and pos and (pos - root.Position).Magnitude < 100 then
                return v, pos
            end
        end
    end
    return nil
end

local function safeGoTo(data)
    if isBusy then return end
    isBusy = true

    local char, root, hum = getChar()
    info.Text = "Yendo a " .. data.N

    -- Crear parte en la posición de destino
    local flightPart = Instance.new("Part")
    flightPart.Size = Vector3.new(4, 1, 4)
    flightPart.Transparency = 1
    flightPart.Anchored = true
    flightPart.CanCollide = false
    flightPart.CanTouch = false
    flightPart.CanQuery = false
    flightPart.CFrame = CFrame.new(data.P + Vector3.new(0, 5, 0))
    flightPart.Parent = workspace

    -- Estado físico
    hum.PlatformStand = true
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    setCollisions(char, false)

    -- Forzar movimiento varias veces al inicio
    for i = 1, 8 do
        root.CFrame = flightPart.CFrame + Vector3.new(0, 3, 0)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        char:PivotTo(flightPart.CFrame + Vector3.new(0, 3, 0))
        task.wait(0.03)
    end

    local connection
    local startTime = tick()

    connection = RS.Heartbeat:Connect(function()
        if not flightPart or not flightPart.Parent or not root or not root.Parent then
            if connection then connection:Disconnect() end
            return
        end

        -- Forzar posición constantemente
        local targetCF = flightPart.CFrame + Vector3.new(0, 3, 0)
        root.CFrame = targetCF
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.new(0, 999, 0)
        pcall(function() char:PivotTo(targetCF) end)

        local npc, pos = findHomeNPC(root)
        if npc and pos then
            local line = string.format("%s → Vector3.new(%.1f, %.1f, %.1f)", npc.Name, pos.X, pos.Y, pos.Z)
            local exists = false
            for _, r in ipairs(results) do
                if r == line then exists = true break end
            end
            if not exists then
                table.insert(results, line)
                updateBox()
            end
            info.Text = data.N .. " ✓ Encontrado"
            connection:Disconnect()
        elseif tick() - startTime > 12 then
            info.Text = data.N .. " ✗ Tiempo agotado"
            connection:Disconnect()
        end
    end)

    while connection and connection.Connected do
        task.wait(0.1)
    end

    -- Restaurar
    hum.PlatformStand = false
    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    setCollisions(char, true)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    if flightPart then flightPart:Destroy() end

    isBusy = false
end

