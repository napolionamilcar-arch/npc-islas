-- 2. LÓGICA DE DETECCIÓN DE COORDENADAS INTERNAS
local function buscarCoordenadasEnReplicated()
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextBox") and child ~= templateBox then
			child:Destroy()
		end
	end

	local carpetaSource = ReplicatedStorage:FindFirstChild(NOMBRE_CARPETA_REPLICATED)
	if not carpetaSource then
		warn("No se encontró la carpeta '" .. NOMBRE_CARPETA_REPLICATED .. "' en ReplicatedStorage.")
		title.Text = "  Error: Carpeta no encontrada en Replicated"
		return
	end

	-- Escanear los objetos/plantillas guardados
	for _, npc in ipairs(carpetaSource:GetChildren()) do
		local coordenadaEncontrada = nil
		local metodoDeteccion = ""

		-- Método A: Buscar si el juego guarda la posición en un Atributo del modelo
		if npc:GetAttribute("SpawnPoint") or npc:GetAttribute("Position") or npc:GetAttribute("CFrame") then
			local attr = npc:GetAttribute("SpawnPoint") or npc:GetAttribute("Position") or npc:GetAttribute("CFrame")
			if typeof(attr) == "Vector3" then
				coordenadaEncontrada = attr
			elseif typeof(attr) == "CFrame" then
				coordenadaEncontrada = attr.Position
			end
			metodoDeteccion = "[Attr]"
		end

		-- Método B: Buscar si tiene un objeto interno de tipo Vector3Value o CFrameValue
		if not coordenadaEncontrada then
			local valorPos = npc:FindFirstChildOfClass("Vector3Value") or npc:FindFirstChild("Position") or npc:FindFirstChild("Spawn")
			local valorCF = npc:FindFirstChildOfClass("CFrameValue") or npc:FindFirstChild("CFrame")

			if valorPos and valorPos:IsA("Vector3Value") then
				coordenadaEncontrada = valorPos.Value
				metodoDeteccion = "[Value]"
			elseif valorCF and valorCF:IsA("CFrameValue") then
				coordenadaEncontrada = valorCF.Value.Position
				metodoDeteccion = "[CFrameV]"
			end
		end

		-- Método C: Si es un clon de mapa que conserva su Pivot original de guardado
		if not coordenadaEncontrada then
			local pivot = npc:GetPivot()
			-- Evitamos la coordenada por defecto (0,0,0) que tienen los modelos vacíos
			if pivot.Position.Magnitude > 1 then
				coordenadaEncontrada = pivot.Position
				metodoDeteccion = "[Pivot]"
			end
		end

		-- Si logramos extraer una coordenada válida, la añadimos a la interfaz
		if coordenadaEncontrada then
			local textoFinal = string.format("%.2f, %.2f, %.2f", coordenadaEncontrada.X, coordenadaEncontrada.Y, coordenadaEncontrada.Z)
			
			local nuevaCaja = templateBox:Clone()
			nuevaCaja.Name = npc.Name
			nuevaCaja.Text = string.format("%s %s = Vector3.new(%s)", metodoDeteccion, npc.Name, textoFinal)
			nuevaCaja.Visible = true
			nuevaCaja.Parent = scrollFrame
		end
	end

	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
end

-- Ejecutar
screenGui.Parent = playerGui
buscarCoordenadasEnReplicated()
